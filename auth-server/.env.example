# Your login server's address (must already point at this server in DNS).
AUTH_DOMAIN=auth.yourdomain.com

# Password for the admin page at https://AUTH_DOMAIN/admin (leave empty to switch the page off).
# Use a long one: openssl rand -base64 18
ADMIN_PASSWORD=

# Different devices allowed per login in the last 30 days (0 = no limit).
MAX_DEVICES=0

# Seconds to wait for an IPTV server to answer.
SERVER_TIMEOUT=8

# Rate limits.
RATE_IP_PER_5MIN=30
RATE_USER_FAILS_PER_15MIN=8

# Behind Caddy: read the real client IP from X-Forwarded-For.
TRUST_PROXY=1
