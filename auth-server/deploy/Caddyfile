# Caddy gets and renews the HTTPS certificate for AUTH_DOMAIN by itself.
# The DNS A record for AUTH_DOMAIN must point at this server before first start.
{$AUTH_DOMAIN} {
	encode gzip

	# The app's endpoints.
	@api path /v1/login /v1/config /healthz
	handle @api {
		reverse_proxy auth:8000
	}

	# Admin page. To allow only your own IP, uncomment the two lines below and put your IP in.
	handle /admin* {
		# @notme not remote_ip 203.0.113.7
		# respond @notme 404
		reverse_proxy auth:8000
	}
	handle {
		respond 404
	}

	request_body {
		max_size 16KB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		# Request bodies (passwords) are never logged by Caddy.
		format console
	}
}
